{
  "name": "cloudvault",
  "version": "1.0.0",
  "description": "CloudVault - Private cloud storage web application designed for shared university laboratory computers",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "test:server": "npm test --prefix server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "keywords": [
    "cloud-storage",
    "private-cloud",
    "university-lab",
    "secure-storage",
    "r2",
    "s3"
  ],
  "author": "CloudVault Team",
  "license": "ISC"
}
