NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/cloudvault

# Session & Security
SESSION_SECRET=your_super_secret_session_encryption_key_here_change_in_production
SESSION_MAX_AGE=7200000
CLIENT_URL=http://localhost:5173

# Storage Quota Configuration
DEFAULT_STORAGE_LIMIT=524288000
MAX_FILE_SIZE=26214400

# Storage Provider Configuration ('local' or 'r2')
STORAGE_PROVIDER=local

# Cloudflare R2 / S3 Configuration (Used when STORAGE_PROVIDER=r2)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=cloudvault-files
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto
